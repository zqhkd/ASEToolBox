%implements "readXComAPI" "C"

%% Function: BlockTypeSetup ===========================================
%%
%function BlockTypeSetup(block, system) void
    %assign data = LibBlockOutputSignal(0, "", "", 0)
    %assign t_data_length = SFcnParamSettings.r_data_length
    %assign fileC = LibGetModelDotCFile()
    %assign fileH = LibGetModelDotHFile()
    %openfile buffer
    #define BUFFER_SIZE %<t_data_length>
    %closefile buffer
    %<LibSetSourceFileSection(fileH, "Defines", buffer)>

    %openfile buffer
    ssize_t bytes_read;   // 接收到数据的字节数前一半
    %closefile buffer    
    %<LibSetSourceFileSection(fileC, "Declarations", buffer)>

    %<LibAddToCommonIncludes("SysComLib.h")>
%endfunction %% BlockTypeSetup

%% Function: BlockInstanceSetup ===========================================
%%
%function BlockInstanceSetup(block, system) void

%endfunction %% BlockInstanceSetup

%% Function: Start ====================================================
%%
%function Start(block, system) Output
    %% %assign t_idxComPort = SFcnParamSettings.r_serial_select
    %assign t_serialName = SFcnParamSettings.r_serialName
    %assign t_baudRate = SFcnParamSettings.r_baudRate
    %assign t_databit = SFcnParamSettings.r_databit
    %assign t_parity = SFcnParamSettings.r_parity
    %assign t_stopbit = SFcnParamSettings.r_stopbit
    %assign t_data_length = SFcnParamSettings.r_data_length
    %assign t_sampleTime = SFcnParamSettings.r_sample_time
    init_serial_tty("/dev/%<t_serialName>",%<t_baudRate>,%<t_databit>,%<t_parity>,%<t_stopbit>, 1, %<t_data_length>);
%endfunction %% Start

%% Function: Outputs ===================================================
%%
%function Outputs(block, system) Output
    %% %assign t_idxComPort = SFcnParamSettings.r_serial_select
    %assign t_serialName = SFcnParamSettings.r_serialName
    %assign t_data_length = SFcnParamSettings.r_data_length
    %assign data = LibBlockOutputSignal(0, "", "", 0)
    read_data_from_tty("/dev/%<t_serialName>", &%<data>, %<t_data_length>);
%endfunction %% Outputs
