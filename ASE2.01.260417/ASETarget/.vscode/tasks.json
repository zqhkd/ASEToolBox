{   
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}/build"
    },
    "tasks": [
        {
            "label": "cmake",
            "type": "shell",
            "command": "cmake",
            "args": [
                ".."
            ]
        },
        {
            "label": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "command": "make",
            "args": [

            ]
        },
        {
            "label": "runWithSudo",
            "type": "shell",
            "command": "sudo",
            "args": [
                "${workspaceFolder}/build/bin/RTA.out"
            ],
            "problemMatcher": []
        },
        {
            "label": "setExeSudo",
            "type": "shell",
            "command": "sudo",
            "args": [
                "setcap",
                "cap_net_admin+ep",
                "${workspaceFolder}/build/bin/asebin"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build",
			"dependsOrder": "sequence", // 按列出的顺序执行任务依赖项
            "dependsOn":[
                "cmake",
                "make"
            ]
        },
        {
            "label": "BuildWithSudo",
			"dependsOrder": "sequence", // 按列出的顺序执行任务依赖项
            "dependsOn":[
                "cmake",
                "make",
                "setExeSudo"
            ]
        }
    ]

}